[Unit]
Description=XITA XGR-funded Token Creator isolated deployment worker
After=network-online.target xita-join.service
Wants=network-online.target

[Service]
Type=oneshot
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
WorkingDirectory=@ROOT@
EnvironmentFile=/etc/xita/join.env
EnvironmentFile=/etc/xita/creator.env
ExecStart=@NODE_BIN@ @ROOT@/services/onboarding/creator-operator.mjs
TimeoutStartSec=90
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/xita/join
UMask=0077
CapabilityBoundingSet=
RestrictSUIDSGID=yes
