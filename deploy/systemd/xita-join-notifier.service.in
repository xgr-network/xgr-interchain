[Unit]
Description=XITA private application status mail delivery
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
WorkingDirectory=@ROOT@
EnvironmentFile=/etc/xita/join.env
ExecStart=@NODE_BIN@ @ROOT@/services/onboarding/status-notifier.mjs --run
TimeoutStartSec=180
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/xita/join
UMask=0077
CapabilityBoundingSet=
RestrictSUIDSGID=yes
