# XITA public SPA + restricted read-only admin.
# Prerequisites: DNS A record for xita.xgr.network, certbot TLS certificate.
# Deploy contents of apps/web to /var/www/xita/current (or update root).
# This example is HTTPS only; use certbot's HTTP bootstrap before enabling.
server {
    listen 80;
    listen [::]:80;
    server_name xita.xgr.network;
    location /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        try_files $uri =404;
    }
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name xita.xgr.network;
    ssl_certificate /etc/letsencrypt/live/xita.xgr.network/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/xita.xgr.network/privkey.pem;

    root /var/www/xita/current;
    index index.html;
    server_tokens off;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Frame-Options DENY always;
    add_header Permissions-Policy 'camera=(), microphone=(), geolocation=()' always;
    # No inline JS is used in the public app. External project logos may load over HTTPS.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' https: data:; connect-src 'self' https://rpc.xgr.network https://explorer.xgr.network https://base-rpc.publicnode.com https://gateway.tenderly.co https://base.gateway.tenderly.co https://bsc-rpc.publicnode.com https://arbitrum-one-rpc.publicnode.com; style-src 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'; form-action 'self'" always;

    location ^~ /admin/ {
        auth_basic "XITA Operator";
        auth_basic_user_file /etc/nginx/.htpasswd-xita;
        proxy_pass http://127.0.0.1:4087;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Authorization "";
        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
        proxy_read_timeout 120s;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
    }
    location = /admin { return 302 /admin/; }

    # Read-only XITA metrics process, separately managed on loopback.
    # A missing service returns 502; it must never fallback to a fabricated zero.
    location = /api/xeta/v1/metrics/toplist {
        proxy_pass http://127.0.0.1:4088;
        proxy_connect_timeout 2s;
        proxy_read_timeout 5s;
        proxy_set_header Host $host;
        add_header Cache-Control "no-store" always;
    }
    location = /api/xeta/v1/visibility {
        proxy_pass http://127.0.0.1:4088;
        proxy_connect_timeout 2s;
        proxy_read_timeout 5s;
        proxy_set_header Host $host;
        add_header Cache-Control "no-store" always;
    }
    # This prefix MUST outrank the generic ^~ /api/xeta/ fail-closed fallback.
    location ^~ /api/xeta/v1/systems/ {
        proxy_pass http://127.0.0.1:4088;
        proxy_connect_timeout 2s;
        proxy_read_timeout 5s;
        proxy_set_header Host $host;
        add_header Cache-Control "no-store" always;
    }

    # Read-only, unsigned Mailbox.process recovery for an existing canonical message.
    # The node relayer does not hold any wallet key and cannot sign or transfer funds.
    location = /api/xeta/v1/transfer/health {
        proxy_pass http://127.0.0.1:4088;
        proxy_connect_timeout 2s;
        proxy_read_timeout 5s;
        proxy_set_header Host $host;
        add_header Cache-Control "no-store" always;
    }
    location = /api/xeta/v1/transfer/recovery {
        proxy_pass http://127.0.0.1:4088;
        proxy_connect_timeout 2s;
        proxy_read_timeout 95s;
        proxy_set_header Host $host;
        add_header Cache-Control "no-store" always;
    }

# Read-only wallet and statistical views of the finalized chain event index.
# No transaction broadcast, wallet private keys, or write methods.
location = /api/xeta/v1/transfers/wallet {
    limit_except GET { deny all; }
    proxy_pass http://127.0.0.1:4088;
    proxy_set_header Host $host;
    proxy_connect_timeout 2s;
    proxy_read_timeout 15s;
    add_header Cache-Control "no-store" always;
}
location = /api/xeta/v1/transfers/stats {
    limit_except GET { deny all; }
    proxy_pass http://127.0.0.1:4088;
    proxy_set_header Host $host;
    proxy_connect_timeout 2s;
    proxy_read_timeout 15s;
    add_header Cache-Control "no-store" always;
}

# Same-origin verified RPC READS, POST only; public methods/params restricted
# by the server to documented catalog endpoints. No tx broadcast or signing.
location = /api/xeta/v1/rpc/read {
    limit_except POST { deny all; }
    client_max_body_size 8k;
    proxy_pass http://127.0.0.1:4088;
    proxy_connect_timeout 2s;
    proxy_read_timeout 20s;
    proxy_set_header Host $host;
    add_header Cache-Control "no-store" always;
}
    # Read-only optional sponsorship status. No wallet/private keys in SPA.
    location = /api/xita/v1/managed/health {
        limit_except GET { deny all; }
        proxy_pass http://127.0.0.1:4092;
        proxy_connect_timeout 2s;
        proxy_read_timeout 4s;
        proxy_set_header Host $host;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options nosniff always;
    }
    # Read-only, receipt-backed sponsorship status for a wallet-owned transfer.
    location = /api/xita/v1/managed/sponsorship {
        limit_except GET { deny all; }
        proxy_pass http://127.0.0.1:4092;
        proxy_connect_timeout 2s;
        proxy_read_timeout 4s;
        proxy_set_header Host $host;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options nosniff always;
    }
    # Quote signer authorizes fees only; actual token movement is always
    # wallet-signed and simulated independently in the public browser.
    location = /api/xita/v1/managed/quote {
        limit_except POST { deny all; }
        client_max_body_size 4k;
        proxy_pass http://127.0.0.1:4092;
        proxy_connect_timeout 2s;
        proxy_read_timeout 15s;
        proxy_set_header Host $host;
        # Replace client-controlled headers with the Nginx peer address.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header CF-IPCountry "";
        proxy_set_header X-Country-Code "";
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options nosniff always;
    }

    # Alliance manifests preview is read-only; PR mutation endpoint remains
    # disabled pending verified project identity and GitHub App installation.
    location = /api/xita/join/preview {
        proxy_pass http://127.0.0.1:4090;
        proxy_connect_timeout 2s;
        proxy_read_timeout 5s;
        client_max_body_size 480k;
        limit_except POST { deny all; }
    }
    # Other XITA event-indexer routes remain disabled until independently verified.
    location ^~ /api/xeta/ {
        default_type application/json;
        return 503 '{"ok":false,"error":"XITA indexer not deployed"}';
    }
    location = /api/xgr-price {
        default_type application/json;
        return 503 '{"ok":false,"error":"Market-data adapter not yet deployed"}';
    }

    # Do not rewrite missing JavaScript assets to index.html.
    location ~* \.js$ { try_files $uri =404; add_header Cache-Control "no-cache" always; }
    location = /catalog.json { add_header Cache-Control "no-store" always; try_files $uri =404; }
    location / { try_files $uri $uri/ /index.html; }
}
