@@ -0,0 +1,119 @@
+name: Release Light (XGR v3.5.1 F-20 Recovery Direct-BLS)
+on:
+  workflow_dispatch:
+    inputs:
+      expected_commit:
+        description: "Reviewed XGR3.0 40-character commit SHA"
+        required: true
+        type: string
+      confirmation:
+        description: "Type RELEASE-v3.5.1 to publish"
+        required: true
+        type: string
+permissions:
+  contents: write
+concurrency:
+  group: xgr-v351-light-release
+  cancel-in-progress: false
+jobs:
+  release:
+    if: ${{ github.ref == 'refs/heads/XGR3.0' }}
+    runs-on: ubuntu-latest
+    timeout-minutes: 120
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          fetch-depth: 0
+      - name: Verify exact reviewed commit, baseline and interchain scope
+        shell: bash
+        env:
+          EXPECTED_COMMIT: ${{ inputs.expected_commit }}
+          CONFIRMATION: ${{ inputs.confirmation }}
+        run: |
+          set -euo pipefail
+          test "$GITHUB_REF" = 'refs/heads/XGR3.0'
+          test "$CONFIRMATION" = 'RELEASE-v3.5.1'
+          [[ "$EXPECTED_COMMIT" =~ ^[0-9a-f]{40}$ ]]
+          test "$(git rev-parse HEAD)" = "$EXPECTED_COMMIT"
+          git rev-parse -q --verify refs/tags/v3.5.0 >/dev/null
+          git merge-base --is-ancestor "$(git rev-parse v3.5.0)" HEAD
+          if git rev-parse -q --verify refs/tags/v3.5.1 >/dev/null; then
+            echo "v3.5.1 already exists" >&2; exit 1
+          fi
+          # Diff against last published release, not just against the PR.
+          # Historical v3.5.0 documentation fixes were merged after the tag.
