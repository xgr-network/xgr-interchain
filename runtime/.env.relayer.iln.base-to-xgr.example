# TRANSPORT NOT CONFIGURED: placeholders must be replaced only by newly verified XITA infrastructure.\n# Do NOT enable or submit the relayer with these placeholders.\n# XITA prelaunch relayer example: Base -> XGRChain
#
# Copy to a non-tracked runtime env file and replace all <...> placeholders.
# Keep RELAYER_SUBMIT=false until the destination ILN ISM path has passed
# process.staticCall validation.

ORIGIN_RPC_URL=https://base-rpc.publicnode.com
ORIGIN_CHAIN_ID=8453
ORIGIN_DOMAIN=8453
ORIGIN_MAILBOX=<NEW_XITA_BASE_MAILBOX_PENDING>
ORIGIN_MERKLE_TREE_HOOK=<NEW_XITA_BASE_MERKLE_HOOK_PENDING>
ORIGIN_ILN_REGISTRY=<SOURCE_ILN_REGISTRY>
ORIGIN_ILN_GATEWAY=<BASE_ILN_GATEWAY>
ORIGIN_WARP_ROUTER=<NEW_XETA_ORIGIN_WARP_ROUTER>
ORIGIN_CONFIRMATIONS=12
ORIGIN_LOG_CHUNK=1000
# ORIGIN_START_BLOCK may be omitted; the relayer then reads ILNGateway.activationBlock().
# ORIGIN_START_BLOCK=<BASE_GATEWAY_DEPLOYMENT_BLOCK>

ATTESTATION_RPC_URL=https://rpc.xgr.network
ATTESTATION_CHAIN_ID=1643
ROUTE_ID=<CANONICAL_NONZERO_ROUTE_ID_BYTES32>
ATTESTATION_ROUTE=base_to_xgr
ATTESTATION_SIGNATURE_FORMAT=compressed

DESTINATION_RPC_URL=https://rpc.xgr.network
DESTINATION_CHAIN_ID=1643
DESTINATION_DOMAIN=1643
DESTINATION_MAILBOX=<NEW_XITA_XGR_MAILBOX_PENDING>
DESTINATION_WARP_ROUTER=<NEW_XETA_DESTINATION_WARP_ROUTER>
DESTINATION_ILN_ISM=<NEW_XETA_DESTINATION_ISM>

# Fresh XETA destination ISM; replace if governed aggregation is deployed.
DESTINATION_AGGREGATION_MODULE_COUNT=0
DESTINATION_AGGREGATION_INNER_INDEX=0
DESTINATION_AGGREGATION_EMPTY_INDEXES=

RELAYER_PRIVATE_KEY=<DESTINATION_GAS_PAYER_PRIVATE_KEY>
RELAYER_SUBMIT=false
RELAYER_STATE_PATH=/data/xeta-iln-base_to_xgr-state.json
POLL_INTERVAL_MS=3000
RELAYER_COMPACT_AFTER_LEAVES=10000
