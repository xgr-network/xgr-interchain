# TRANSPORT NOT CONFIGURED: placeholders must be replaced only by newly verified XITA infrastructure.\n# Do NOT enable or submit the relayer with these placeholders.\n# XITA clean-room mainnet wiring; no legacy infrastructure addresses.
# Do not apply without checking exact supported env settings on frozen xgr-node v3.1.4.
# Historical transport addresses are intentionally not reusable.
# Non-secret reference values for /etc/xgrchain/node.conf.
#

XGR_INTERCHAIN_ORIGIN_MAILBOX_ADDR=<NEW_XITA_XGR_MAILBOX_PENDING>
XGR_INTERCHAIN_ORIGIN_MERKLE_TREE_HOOK_ADDR=<NEW_XITA_XGR_MERKLE_HOOK_PENDING>

# Base network
XGR_INTERCHAIN_BASE_CHAIN_ID=8453
XGR_INTERCHAIN_BASE_DOMAIN=8453
XGR_INTERCHAIN_BASE_ILN_REGISTRY_ADDR=<NEW_BASE_ILN_REGISTRY>
XGR_INTERCHAIN_BASE_RPC=https://base-rpc.publicnode.com
XGR_INTERCHAIN_BASE_CONFIRMATIONS=12
XGR_INTERCHAIN_BASE_DEACTIVATION_RESERVE_WEI=200000000000000
XGR_INTERCHAIN_BASE_MEMBERSHIP_VALIDITY_SECONDS=300
XGR_INTERCHAIN_BASE_EXECUTOR_STEP_DELAY_SECONDS=10
XGR_INTERCHAIN_BASE_VERIFIER_FORMAT=eip2537

# XGRChain network
XGR_INTERCHAIN_XGR_CHAIN_ID=1643
XGR_INTERCHAIN_XGR_DOMAIN=1643
XGR_INTERCHAIN_XGR_ILN_REGISTRY_ADDR=<NEW_XGR_ILN_REGISTRY>
XGR_INTERCHAIN_XGR_RPC=http://127.0.0.1:8545
XGR_INTERCHAIN_XGR_CONFIRMATIONS=1
XGR_INTERCHAIN_XGR_DEACTIVATION_RESERVE_WEI=1000000000000000000
XGR_INTERCHAIN_XGR_MEMBERSHIP_VALIDITY_SECONDS=300
XGR_INTERCHAIN_XGR_EXECUTOR_STEP_DELAY_SECONDS=10
XGR_INTERCHAIN_XGR_VERIFIER_FORMAT=compressed

# Explicit Base-spoke routes
XGR_INTERCHAIN_ROUTE_XGR_TO_BASE_SOURCE_NETWORK=xgr
XGR_INTERCHAIN_ROUTE_XGR_TO_BASE_DESTINATION=base

XGR_INTERCHAIN_ROUTE_BASE_TO_XGR_SOURCE_NETWORK=base
XGR_INTERCHAIN_ROUTE_BASE_TO_XGR_DESTINATION=xgr
