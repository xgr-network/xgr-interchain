# XITA / XGR Interchain mainnet - chain-only validator configuration
# This is a non-secret example for the xgr-node XGR3.0 ILN worker.
# RouteAdded events in the source ILN Registries are discovered automatically.
# DO NOT add XGR_INTERCHAIN_ROUTE_* entries, one per token, or old ORIGIN_*.
# Apply to a matching node binary; verify systemd EnvironmentFile before restart.
#
# Base destination AND source
XGR_INTERCHAIN_BASE_CHAIN_ID=8453
XGR_INTERCHAIN_BASE_DOMAIN=8453
XGR_INTERCHAIN_BASE_REGISTRY_ADDR=0xcf7e1a877d919c1c8dba48b42a832bdb1042101f
XGR_INTERCHAIN_BASE_ILN_REGISTRY_ADDR=0xbd87ceebbac310186b0caf2ec4ed6c50f7d767c3
# Primary: Chainlist Tenderly; historical 150-block eth_getLogs / eth_call tested.
# Alternate same-provider endpoint: https://base.gateway.tenderly.co
XGR_INTERCHAIN_BASE_RPC=https://gateway.tenderly.co/public/base
XGR_INTERCHAIN_BASE_CONFIRMATIONS=12
XGR_INTERCHAIN_BASE_MEMBERSHIP_VALIDITY_SECONDS=300
XGR_INTERCHAIN_BASE_EXECUTOR_STEP_DELAY_SECONDS=10
XGR_INTERCHAIN_BASE_VERIFIER_FORMAT=eip2537
XGR_INTERCHAIN_BASE_DEACTIVATION_RESERVE_WEI=100000000000000

# XGRChain destination AND source
XGR_INTERCHAIN_XGR_CHAIN_ID=1643
XGR_INTERCHAIN_XGR_DOMAIN=1643
XGR_INTERCHAIN_XGR_REGISTRY_ADDR=0x65a9473b0a7c5ec27127125c05fb4efc29efdba6
XGR_INTERCHAIN_XGR_ILN_REGISTRY_ADDR=0x590d9d35276661f250e2cdf83d32a0e1cbebac38
# Use the XGR RPC reachable from THIS validator, verify chain ID 1643.
XGR_INTERCHAIN_XGR_RPC=http://127.0.0.1:8545
XGR_INTERCHAIN_XGR_CONFIRMATIONS=1
XGR_INTERCHAIN_XGR_MEMBERSHIP_VALIDITY_SECONDS=300
XGR_INTERCHAIN_XGR_EXECUTOR_STEP_DELAY_SECONDS=10
XGR_INTERCHAIN_XGR_VERIFIER_FORMAT=compressed

# New routes per source chain:
#   source ILNRegistry.RouteAdded -> validator worker discovery -> canonical
#   getRoute + Gateway binding verification -> quorum after source confirmation.
# No static route IDs, contract gateway/router addresses, or per-token reloads.
