# XGR ILN v3.1.4 relayer example: XGRChain -> Base
#
# Copy to a non-tracked runtime env file and replace all <...> placeholders.
# Keep RELAYER_SUBMIT=false until the Base ILN ISM has passed
# Mailbox.process.staticCall validation.

ORIGIN_RPC_URL=https://rpc.xgr.network
ORIGIN_CHAIN_ID=1643
ORIGIN_DOMAIN=1643
ORIGIN_MAILBOX=0x5632409bc2f0e8bAc4AaF43654D4FFc7822C9c79
ORIGIN_MERKLE_TREE_HOOK=0xeD98Af715b5a72dCD412567eb086d48225CDDACF
ORIGIN_ILN_REGISTRY=<SOURCE_ILN_REGISTRY>
ORIGIN_ILN_GATEWAY=<XGR_ILN_GATEWAY>
ORIGIN_WARP_ROUTER=<NEW_XETA_ORIGIN_WARP_ROUTER>
ORIGIN_CONFIRMATIONS=1
ORIGIN_LOG_CHUNK=1000
# ORIGIN_START_BLOCK may be omitted; the relayer then reads ILNGateway.activationBlock().
# ORIGIN_START_BLOCK=<XGR_GATEWAY_DEPLOYMENT_BLOCK>

ATTESTATION_RPC_URL=https://rpc.xgr.network
ATTESTATION_CHAIN_ID=1643
ROUTE_ID=<CANONICAL_NONZERO_ROUTE_ID_BYTES32>
ATTESTATION_ROUTE=xgr_to_base
ATTESTATION_SIGNATURE_FORMAT=eip2537

DESTINATION_RPC_URL=https://base-rpc.publicnode.com
DESTINATION_CHAIN_ID=8453
DESTINATION_DOMAIN=8453
DESTINATION_MAILBOX=0xeA87ae93Fa0019a82A727bfd3eBd1cFCa8f64f1D
DESTINATION_WARP_ROUTER=<NEW_XETA_DESTINATION_WARP_ROUTER>
DESTINATION_ILN_ISM=<NEW_XETA_DESTINATION_ISM>

# Verify the actual XETA destination ISM configuration before enabling.
DESTINATION_AGGREGATION_MODULE_COUNT=0
DESTINATION_AGGREGATION_INNER_INDEX=0
DESTINATION_AGGREGATION_EMPTY_INDEXES=

RELAYER_PRIVATE_KEY=<BASE_GAS_PAYER_PRIVATE_KEY>
RELAYER_SUBMIT=false
RELAYER_STATE_PATH=/data/xeta-iln-xgr_to_base-state.json
POLL_INTERVAL_MS=3000
RELAYER_COMPACT_AFTER_LEAVES=10000
