# Quote signer only. Copy to /etc/xita/quote.env, chmod 0600.
# The quotient source contract's relayerOwner() must equal this wallet.
XITA_INTERCHAIN_QUOTE_PRIVATE_KEY=<PRIVATE_FEE_QUOTE_SIGNER_KEY>
# PUBLIC GmbH beneficiary address, shared across chains. The matching
# private beneficiary key belongs ONLY in /etc/xita/interchain-fee.env.
XITA_INTERCHAIN_FEE_ADDRESS=<PUBLIC_GMBH_INTERCHAIN_FEE_ADDRESS>
XITA_INTERCHAIN_BASE_ADAPTER=<DEPLOYED_BASE_GATEWAY>
XITA_INTERCHAIN_POLYGON_ADAPTER=<DEPLOYED_POLYGON_GATEWAY>
XITA_INTERCHAIN_XGRCHAIN_ADAPTER=<DEPLOYED_XGRCHAIN_GATEWAY>
# When newly deployed, add:
# XITA_INTERCHAIN_ARBITRUM_ADAPTER=<DEPLOYED_ARBITRUM_GATEWAY>
XITA_MANAGED_QUOTE_PORT=4092
XITA_COINGECKO_API_KEY=<OPTIONAL_API_KEY>
# Quote signer can READ but never modify operator's heartbeat.
XITA_SPONSOR_STATUS_DATABASE_URL=<READ_ONLY_POSTGRES_URL>
XITA_INTERCHAIN_SPONSOR_ENABLED=false
