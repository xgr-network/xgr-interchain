# XITA optional Interchain Fee pricing and sponsor/claim operators.
# Store REAL values only in /etc/xita/interchain-fee.env (0600). Never commit.
# Quote signer signs only typed fee quotes; it never signs client transfers.
XITA_INTERCHAIN_QUOTE_PRIVATE_KEY=<FEE_QUOTE_SIGNER_KEY>
# This EVM wallet receives ALL accrued Interchain Fees per source chain and
# may optionally fund destination wallet gas. NEVER share this key with the UI
# or the read-only chain-indexer service. Separate OS service permissions.
XITA_INTERCHAIN_FEE_PRIVATE_KEY=<INTERCHAIN_FEE_GMBH_PRIVATE_KEY>
XITA_INTERCHAIN_FEE_ADDRESS=<INTERCHAIN_FEE_GMBH_PUBLIC_ADDRESS>
XITA_INTERCHAIN_BASE_ADAPTER=<VERIFIED_BASE_ADAPTER>
# Optional; enable only once these adapters are independently deployed:
# XITA_INTERCHAIN_POLYGON_ADAPTER=<VERIFIED_POLYGON_ADAPTER>
# XITA_INTERCHAIN_XGRCHAIN_ADAPTER=<VERIFIED_XGRCHAIN_ADAPTER>
# Each asset's balance is independently denominated in its native currency.
# Claim the entire pendingInterchainFeesWei() once this native-wei threshold
# is exceeded and claim gas is < 1/3 of proceeds, using ONE claimFees() call.
# No per-user/per-message claims, scans or receipt lists are needed.
XITA_INTERCHAIN_BASE_MIN_CLAIM_WEI=100000000000000
XITA_INTERCHAIN_POLYGON_MIN_CLAIM_WEI=1000000000000000000
XITA_INTERCHAIN_XGRCHAIN_MIN_CLAIM_WEI=1000000000000000000
# Deliberately opt-in separately. Claims do not mean gas grants are active.
XITA_INTERCHAIN_CLAIM_ENABLED=false
XITA_INTERCHAIN_SPONSOR_ENABLED=false
# Optional price feed key stays on the quote-only server.
# XITA_COINGECKO_API_KEY=<SECRET_API_KEY>
