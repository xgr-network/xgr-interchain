# XITA fee quote signer: authorizes price only, cannot execute customer transfers.
# Production: /etc/xita/interchain-fee.env, chmod 0600, restricted service user.
# NEVER commit a real private key. Do not load in public web/indexer process.
XITA_INTERCHAIN_QUOTE_PRIVATE_KEY=<PRIVATE_QUOTE_SIGNER_KEY>
# GmbH fee beneficiary also sponsors native gas grants on XGRChain/destination.
# This address MUST equal the immutable interchainFeeRecipient() of each
# configured ExecutionGateway. Cross-chain balances remain independent.
XITA_INTERCHAIN_FEE_PRIVATE_KEY=<PRIVATE_GMBH_FEE_SPONSOR_KEY>
XITA_INTERCHAIN_FEE_ADDRESS=<PUBLIC_GMBH_FEE_SPONSOR_ADDRESS>
XITA_INTERCHAIN_XGRCHAIN_ADAPTER=<VERIFIED_XGRCHAIN_ADAPTER>
XITA_INTERCHAIN_BASE_ADAPTER=<VERIFIED_BASE_ADAPTER>
# Only documented deployments and source receipt starting blocks are accepted.
XITA_INTERCHAIN_XGRCHAIN_DEPLOY_BLOCK=<VERIFIED_XGRCHAIN_BLOCK>
XITA_INTERCHAIN_BASE_DEPLOY_BLOCK=<VERIFIED_BASE_BLOCK>
# Minimum native amount below which a batch withdraw should not be submitted,
# in source-chain wei (to prevent uneconomical single-receipt gas costs).
XITA_INTERCHAIN_MIN_CLAIM_WEI=<CONFIGURED_MINIMUM_WEI>
# Gas grants and claim broadcasting disabled until verified operator policy.
XITA_INTERCHAIN_SPONSOR_ENABLED=false
