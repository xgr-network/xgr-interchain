# OPTIONAL GmbH-operated service, NOT protocol infrastructure.
# Deploy ONE XITAExecutionGateway per SOURCE chain before enabling quotes.
# Requires a funded relayer EOA with sufficient destination-native gas.
# Never commit real values to Git; install env as mode 0600.
XITA_MANAGED_RELAYER_PRIVATE_KEY=<SECRET_HEX_KEY>
XITA_MANAGED_XGRCHAIN_EXECUTION_ADDRESS=<DEPLOYED_SOURCE_ADAPTER_ON_XGR>
XITA_MANAGED_BASE_EXECUTION_ADDRESS=<DEPLOYED_SOURCE_ADAPTER_ON_BASE>
XITA_MANAGED_QUOTE_PORT=4092
# Optional CoinGecko demo API key:
# XITA_COINGECKO_API_KEY=<SECRET_KEY>
