# /etc/xita/interchain-fee.env  (mode 0600, group/owner restricted).
# The ONE operational wallet signs quotes, receives accumulated fees, and
# sends voluntary gas grants. Recovery Admin is a DIFFERENT wallet, never in this file.
# The same EVM address receives Fees on each source chain and sponsors
# destination gas; no automatic ETH/POL/XGR currency conversion happens.
XITA_INTERCHAIN_FEE_PRIVATE_KEY=<PRIVATE_GMBH_SERVICE_WALLET_KEY>
XITA_INTERCHAIN_FEE_ADDRESS=<PUBLIC_GMBH_INTERCHAIN_FEE_ADDRESS>
XITA_INTERCHAIN_CLAIM_ENABLED=false
XITA_INTERCHAIN_SPONSOR_ENABLED=false
XITA_SPONSOR_DATABASE_URL=<POSTGRES_WORKER_CONNECTION_WITH_ONLY_NEEDED_TABLE_PERMISSIONS>
XITA_SPONSOR_STATUS_DATABASE_URL=<POSTGRES_READ_ONLY_CONNECTION>
# Execution Gateway addresses come ONLY from apps/web/catalog.json and
# checked-in GitHub deployment receipts. Never duplicate adapters in ENV.
# ONE full-saldo claimFees per chain if accrued > native-wei threshold and
# gas would be <= 1/3 of proceeds. The following are OPERATOR CHOICES,
# never recommended default transfer amounts.
XITA_INTERCHAIN_BASE_MIN_CLAIM_WEI=<EXPLICIT_NATIVE_WEI_THRESHOLD>
XITA_INTERCHAIN_POLYGON_MIN_CLAIM_WEI=<EXPLICIT_NATIVE_WEI_THRESHOLD>
XITA_INTERCHAIN_XGRCHAIN_MIN_CLAIM_WEI=<EXPLICIT_NATIVE_WEI_THRESHOLD>
XITA_INTERCHAIN_ARBITRUM_MIN_CLAIM_WEI=<EXPLICIT_NATIVE_WEI_THRESHOLD>
# Sponsor policy per destination chain. Require ALL limits before enabling.
XITA_SPONSOR_BASE_MAX_GRANT_WEI=<MAX_GRANT_WEI>
XITA_SPONSOR_BASE_DAILY_MAX_WEI=<MAX_TOTAL_24H_WEI>
XITA_SPONSOR_BASE_MIN_RESERVE_WEI=<MINIMUM_SPONSOR_RESERVE_WEI>
XITA_SPONSOR_BASE_GAS_UNITS=1200000
XITA_SPONSOR_POLYGON_MAX_GRANT_WEI=<MAX_GRANT_WEI>
XITA_SPONSOR_POLYGON_DAILY_MAX_WEI=<MAX_TOTAL_24H_WEI>
XITA_SPONSOR_POLYGON_MIN_RESERVE_WEI=<MINIMUM_SPONSOR_RESERVE_WEI>
XITA_SPONSOR_POLYGON_GAS_UNITS=1200000
XITA_SPONSOR_XGRCHAIN_MAX_GRANT_WEI=<MAX_GRANT_WEI>
XITA_SPONSOR_XGRCHAIN_DAILY_MAX_WEI=<MAX_TOTAL_24H_WEI>
XITA_SPONSOR_XGRCHAIN_MIN_RESERVE_WEI=<MINIMUM_SPONSOR_RESERVE_WEI>
XITA_SPONSOR_XGRCHAIN_GAS_UNITS=1200000

# Base -> XGRChain -> Arbitrum needs XGR hub and Arbitrum destination reserves.
# All limits on Arbitrum are denominated in native ETH wei.
XITA_SPONSOR_ARBITRUM_MAX_GRANT_WEI=<MAX_GRANT_WEI>
XITA_SPONSOR_ARBITRUM_DAILY_MAX_WEI=<MAX_TOTAL_24H_WEI>
XITA_SPONSOR_ARBITRUM_MIN_RESERVE_WEI=<MINIMUM_SPONSOR_RESERVE_WEI>
XITA_SPONSOR_ARBITRUM_GAS_UNITS=1200000

# XITA initial paid fee tax-evidence pipeline, PostgreSQL INSERT-only role.
# Configure ONLY when schema 009 and local country CIDR dataset are installed.
XITA_TAX_QUOTE_DATABASE_URL=<POSTGRES_INSERT_ONLY_TAX_QUOTE_CONNECTION>
# Local CIDR,ISO2 mapping, as in XGR_Web OTC backend (no per-user external API).
XITA_TAX_COUNTRY_CIDR_PATH=/var/lib/xita/ip-country-db.csv
