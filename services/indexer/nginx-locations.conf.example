# Example Nginx locations in the xita.xgr.network HTTPS server block.
# Install only when xita-indexer.service is healthy.
# Never expose /api/xeta/join, admin or RPC through this listener.
location ^~ /api/xeta/v1/metrics/ {
    proxy_pass http://127.0.0.1:4088;
    proxy_set_header Host $host;
    proxy_connect_timeout 2s;
    proxy_read_timeout 12s;
}
location ^~ /api/xeta/v1/systems/ {
    proxy_pass http://127.0.0.1:4088;
    proxy_set_header Host $host;
    proxy_connect_timeout 2s;
    proxy_read_timeout 12s;
}

# Public read-only destination proof preparation; only the user's wallet may sign.
location = /api/xeta/v1/transfer/recovery {
 proxy_pass http://127.0.0.1:4088;
 proxy_connect_timeout 2s;
 proxy_read_timeout 95s;
}

# Execution safety: block source lock if proof builder is not installed.
location = /api/xeta/v1/transfer/health {
 proxy_pass http://127.0.0.1:4088;
 proxy_connect_timeout 2s;
 proxy_read_timeout 5s;
}
