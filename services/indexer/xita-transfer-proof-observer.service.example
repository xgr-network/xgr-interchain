[Unit]
Description=XITA persistent unsigned validator proof observer (read-only RPC)
After=network-online.target postgresql.service xita-transfer-indexer.service
Wants=network-online.target

[Service]
Type=simple
User=xgradmin
WorkingDirectory=/home/xgradmin/repos/xgr-interchain
EnvironmentFile=/etc/xita/transfer-indexer.env
ExecStart=/usr/bin/node services/indexer/transfer-proof-observer.mjs
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/tmp
UMask=0077

[Install]
WantedBy=multi-user.target
