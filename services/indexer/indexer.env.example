# Set in /etc/xita/indexer.env with mode 0600.
# This is a restricted SELECT-only role. Do not reuse the writer account.
XITA_INDEXER_DATABASE_URL=postgresql://xita_indexer_reader:CHANGEME@127.0.0.1:5432/xita
# For optional SQL 005 the same SELECT-only role also needs
# GRANT SELECT ON xita_transfer_announcements.
