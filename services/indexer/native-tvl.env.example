# Use a dedicated read-only indexer DB role. No writer credentials, no wallet keys.
# The price feed is the repository-configured XGR CoinGecko ID.
XITA_INDEXER_DATABASE_URL=postgresql://xita_indexer_reader:CHANGEME@127.0.0.1:5432/xita
XITA_METRICS_EVIDENCE=/var/lib/xita/native-tvl-evidence.json
# Never point this job at a user-controlled file.
