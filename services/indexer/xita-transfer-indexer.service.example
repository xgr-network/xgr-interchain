[Unit]
Description=XITA finalized Gateway/Mailbox event index (read-only RPC, derived DB writes)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=xgradmin
WorkingDirectory=/home/xgradmin/repos/xgr-interchain
EnvironmentFile=/etc/xita/transfer-indexer.env
ExecStart=/usr/bin/node services/indexer/transfer-index-worker.mjs
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/tmp
UMask=0077

[Install]
WantedBy=multi-user.target
