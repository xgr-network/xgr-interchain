[Unit]
Description=XITA XGR Node-index to PostgreSQL projector (no foreign-chain RPC)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=xgradmin
WorkingDirectory=/home/xgradmin/repos/xgr-interchain
EnvironmentFile=/etc/xita/transfer-indexer.env
ExecStart=/usr/bin/node services/indexer/node-index-projector.mjs
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/tmp
UMask=0077

[Install]
WantedBy=multi-user.target
