# Set in /etc/xita/transfer-indexer.env (permissions 0600).
# This is a RESTRICTED WRITE ROLE for the two xita_transfer_* DERIVED
# PostgreSQL tables ONLY. Never use a validator, wallet, or treasury key.
XITA_TRANSFER_WORKER_DATABASE_URL=postgresql://xita_transfer_worker:CHANGEME@127.0.0.1:5432/xita
# For optional SQL 005 this existing finalized worker role additionally needs
# SELECT, UPDATE, DELETE on xita_transfer_announcements.
# The worker (not the HTTP intake) writes canonical verified operations.

# All operational foreign-chain observations are read through this trusted
# XGR Node index. No public user URL, external archive endpoint or key.
# Use the same reachable XGR RPC in the transfer projector and TVL publisher.
XITA_XGR_INDEX_RPC_URL=https://rpc.xgr.network
