# Set in /etc/xita/transfer-indexer.env (permissions 0600).
# This is a RESTRICTED WRITE ROLE for the two xita_transfer_* DERIVED
# PostgreSQL tables ONLY. Never use a validator, wallet, or treasury key.
XITA_TRANSFER_WORKER_DATABASE_URL=postgresql://xita_transfer_worker:CHANGEME@127.0.0.1:5432/xita
