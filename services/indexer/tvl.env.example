# Restricted SELECT-only account for transfer operations and route cursors.
XITA_INDEXER_DATABASE_URL=postgresql://xita_indexer_reader:CHANGEME@127.0.0.1:5432/xita
# The indexer API must use the exact same path via /etc/xita/indexer.env.
XITA_METRICS_EVIDENCE=/var/lib/xita/verified-tvl.json

# All operational foreign-chain observations are read through this trusted
# XGR Node index. No public user URL, external archive endpoint or key.
# Use the same reachable XGR RPC in the transfer projector and TVL publisher.
XITA_XGR_INDEX_RPC_URL=https://rpc.xgr.network
